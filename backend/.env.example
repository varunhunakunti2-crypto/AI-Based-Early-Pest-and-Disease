APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
# Interactive docs are available in dev/staging; production hides them unless
# this is explicitly true.
APP_DOCS_ENABLED=true

# SQLAlchemy URL (PostgreSQL 16 + PostGIS in compose). No credentials in source.
APP_DATABASE_URL=postgresql+psycopg://ps03:ps03@localhost:5432/ps03

# JSON list of browser origins allowed to call this API.
APP_CORS_ORIGINS=["http://localhost:3000"]

# Identity (spec 03). Replace the secret outside local development; production
# refuses the default and requires at least 32 characters. TOTP seeds and
# bootstrap credentials must never be committed.
APP_AUTH_SECRET=dev-only-insecure-secret-change-me
# APP_AUTH_ACCESS_TTL_MINUTES=15
# APP_AUTH_REFRESH_TTL_DAYS=30
# APP_AUTH_OTP_TTL_MINUTES=5
# APP_AUTH_OTP_MAX_ATTEMPTS=5
# APP_AUTH_OTP_PHONE_LIMIT=5
# APP_AUTH_OTP_IP_LIMIT=20
# APP_AUTH_OTP_RATE_WINDOW_MINUTES=15
# APP_AUTH_STAFF_FAILURE_LIMIT=10
# APP_AUTH_STAFF_LOCKOUT_MINUTES=15

# Decision D10 is open. Leave unset: deletion is soft with no hard-delete date.
# APP_AUTH_DELETION_RETENTION_DAYS=

# One-time first-admin bootstrap. Supply all three or none; never log them.
# APP_AUTH_BOOTSTRAP_ADMIN_EMAIL=
# APP_AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# APP_AUTH_BOOTSTRAP_ADMIN_TOTP_SECRET=

# Chat assessment engine (spec 08). ``demo`` is the labelled deterministic
# engine. ``openai_compatible`` calls a vision model; the model may only choose
# from APP_CHAT_LABELS, and replies stay template-rendered and validator-checked.
# Leave the key unset to fail closed. Results stay demo-labelled until the label
# set is the approved D1/D2 taxonomy and APP_CHAT_LABELS_APPROVED=true.
# APP_CHAT_ENGINE=demo
# APP_CHAT_API_KEY=
# APP_CHAT_BASE_URL=https://api.openai.com/v1
# APP_CHAT_MODEL=
# APP_CHAT_LABELS=[{"label":"early_blight","display_name":"Possible early blight"}]
# APP_CHAT_LABELS_APPROVED=false
# APP_CHAT_TIMEOUT_S=30
# APP_CHAT_MAX_IMAGE_SIDE=1024

# Pretrained YOLO detectors (demo-only). They run in the isolated ``ml/serve``
# process because ``ultralytics`` is AGPL-3.0; this API only calls it over HTTP.
# Output is always is_demo=true with unverified raw labels until the D1a
# taxonomy and an operating point are approved. Do not deploy this path without
# a licensing decision and a reachable inference service.
# APP_CHAT_ENGINE=pretrained
# APP_PRETRAINED_INFERENCE_URL=http://127.0.0.1:8010
# APP_PRETRAINED_MODEL=plant
# APP_PRETRAINED_CONF=0.25
# APP_PRETRAINED_TIMEOUT_S=60

# Local upload storage. A deployment replaces this with object storage.
# APP_MEDIA_ROOT=var/media
# APP_MAX_UPLOAD_BYTES=10485760
# APP_MAX_IMAGE_DIMENSION=8000

# Video reading (spec 09). Short clips only; every ceiling is enforced before or
# during decode. The shipped detector is demo-only, so readings stay
# demo-labelled and require human review until D15 is decided.
# APP_VIDEO_MAX_BYTES=52428800
# APP_VIDEO_MAX_DURATION_S=30
# APP_VIDEO_MAX_DIMENSION=1920
# APP_VIDEO_SAMPLE_FPS=2
# APP_VIDEO_MAX_FRAMES=24
# APP_VIDEO_FRAME_MAX_SIDE=1024
# APP_VIDEO_MIN_USABLE_FRAMES=3
# APP_VIDEO_MIN_DURATION_MS=500
# APP_VIDEO_ASSESS_FRAMES=3
# APP_VIDEO_TRACK_IOU=0.3
# APP_VIDEO_TRACK_MAX_AGE=5
# APP_VIDEO_MOTION_THRESHOLD=25
# APP_VIDEO_MOTION_MIN_AREA_FRACTION=0.005
