# Local development only. Copy to deploy/.env (untracked) before `docker compose`.
#
# These are throwaway local credentials, not secrets for any shared environment.
# Staging and production inject values from the platform secret store.
POSTGRES_USER=ps03
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ps03
POSTGRES_PORT=5432

APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=true

# Local-only identity secret. Replace for any shared environment; production
# refuses this value and requires at least 32 characters.
APP_AUTH_SECRET=dev-only-insecure-secret-change-me

# Chat engine (spec 08). Leave the provider key unset to run the labelled demo
# engine. Set APP_CHAT_ENGINE=openai_compatible and supply the model and the
# approved label JSON to call a vision provider; results stay demo-labelled
# until APP_CHAT_LABELS_APPROVED=true.
APP_CHAT_ENGINE=demo
# APP_CHAT_API_KEY=
# APP_CHAT_BASE_URL=https://api.openai.com/v1
# APP_CHAT_MODEL=
# APP_CHAT_LABELS=[{"label":"early_blight","display_name":"Possible early blight"}]
# APP_CHAT_LABELS_APPROVED=false

# Pretrained YOLO detectors (demo-only). They run in the isolated ``ml/serve``
# process because ``ultralytics`` is AGPL-3.0; the API only calls it over HTTP.
# Output is always is_demo=true with unverified raw labels until the D1a
# taxonomy and an operating point are approved. Do not deploy this path without
# a licensing decision and a reachable inference service.
# APP_CHAT_ENGINE=pretrained
# APP_PRETRAINED_INFERENCE_URL=http://127.0.0.1:8010
# APP_PRETRAINED_MODEL=plant
# APP_PRETRAINED_CONF=0.25
# APP_PRETRAINED_TIMEOUT_S=60

# Video reading (spec 09). The detector is demo-only in this phase; leave these
# at their defaults unless a deployment needs a tighter clip ceiling.
# APP_VIDEO_MAX_BYTES=52428800
# APP_VIDEO_MAX_DURATION_S=30
# APP_VIDEO_MAX_DIMENSION=1920
# APP_VIDEO_SAMPLE_FPS=2
# APP_VIDEO_MAX_FRAMES=24
# APP_VIDEO_FRAME_MAX_SIDE=1024
# APP_VIDEO_MIN_USABLE_FRAMES=3
# APP_VIDEO_MIN_DURATION_MS=500
# APP_VIDEO_ASSESS_FRAMES=3
# APP_VIDEO_TRACK_IOU=0.3
# APP_VIDEO_TRACK_MAX_AGE=5
# APP_VIDEO_MOTION_THRESHOLD=25
# APP_VIDEO_MOTION_MIN_AREA_FRACTION=0.005

API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
